<!--
  Windows GPU-passthrough VM — RTX 3070 + Looking Glass
  ======================================================
  PRE-FLIGHT (do once, before virsh define):

  1. Install AMD host GPU, reboot, verify IOMMU groups:
       find /sys/kernel/iommu_groups/*/devices -name '0000:08:00.*'
     The RTX 3070 and its audio device must be in a group with no other
     devices you need on the host. If not, you may need the ACS kernel patch.

  2. Uncomment "vfio-pci.ids=10de:2484,10de:228b" in virtualisation.nix,
     then rebuild and reboot. Confirm with:
       lspci -nnk -d 10de:2484 | grep 'Kernel driver'  # should say vfio-pci

  3. Create disk image and download ISOs:
       sudo qemu-img create -f qcow2 /var/lib/libvirt/images/windows.qcow2 128G
       # Place Windows ISO at:  /var/lib/libvirt/images/windows.iso
       # Download VirtIO drivers: https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/stable-virtio/virtio-win.iso
       # Place at:               /var/lib/libvirt/images/virtio-win.iso

  4. Define and start:
       virsh define /home/bosko/NixOS/hosts/gaming/windows-vm.xml
       virsh start windows

  POST-INSTALL (inside Windows, after OS is installed):
  - Install VirtIO guest drivers from the virtio-win CD
  - Install Looking Glass host binary from https://looking-glass.io/downloads
    (match version to looking-glass-client package on the host)
  - The Looking Glass host will write frames to the IVSHMEM buffer;
    on the host run:  looking-glass-client
-->

<domain type='kvm' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <name>windows</name>
  <uuid>REPLACE-WITH-OUTPUT-OF-uuidgen</uuid>

  <memory unit='MiB'>32768</memory>
  <currentMemory unit='MiB'>32768</currentMemory>

  <!--
    CPU pinning: VM gets physical cores 2-7 (12 logical), host keeps cores 0-1.
    Ryzen 3700X CCX layout — CCX0: cores 0-3, CCX1: cores 4-7.
    SMT pairs: physical core N → threads N and N+8.
  -->
  <vcpu placement='static'>12</vcpu>
  <cputune>
    <vcpupin vcpu='0'  cpuset='2'/>
    <vcpupin vcpu='1'  cpuset='10'/>
    <vcpupin vcpu='2'  cpuset='3'/>
    <vcpupin vcpu='3'  cpuset='11'/>
    <vcpupin vcpu='4'  cpuset='4'/>
    <vcpupin vcpu='5'  cpuset='12'/>
    <vcpupin vcpu='6'  cpuset='5'/>
    <vcpupin vcpu='7'  cpuset='13'/>
    <vcpupin vcpu='8'  cpuset='6'/>
    <vcpupin vcpu='9'  cpuset='14'/>
    <vcpupin vcpu='10' cpuset='7'/>
    <vcpupin vcpu='11' cpuset='15'/>
    <emulatorpin cpuset='0-1,8-9'/>
  </cputune>

  <os>
    <type arch='x86_64' machine='pc-q35-9.2'>hvm</type>
    <!-- NixOS-managed OVMF paths — verify with: ls /run/libvirt/nix-ovmf/ -->
    <loader readonly='yes' type='pflash'>/run/libvirt/nix-ovmf/OVMF_CODE.fd</loader>
    <nvram template='/run/libvirt/nix-ovmf/OVMF_VARS.fd'>/var/lib/libvirt/qemu/nvram/windows_VARS.fd</nvram>
    <bootmenu enable='yes'/>
  </os>

  <features>
    <acpi/>
    <apic/>
    <hyperv mode='custom'>
      <relaxed state='on'/>
      <vapic state='on'/>
      <spinlocks state='on' retries='8191'/>
      <vpindex state='on'/>
      <synic state='on'/>
      <stimer state='on'/>
      <reset state='on'/>
      <!-- Spoof vendor ID so NVIDIA driver doesn't refuse to run in a VM -->
      <vendor_id state='on' value='GenuineIntel'/>
      <frequencies state='on'/>
      <reenlightenment state='on'/>
      <tlbflush state='on'/>
    </hyperv>
    <kvm>
      <!-- Hide KVM from NVIDIA driver (Error 43 fix) -->
      <hidden state='on'/>
    </kvm>
    <vmport state='off'/>
    <ioapic driver='kvm'/>
  </features>

  <cpu mode='host-passthrough' check='none' migratable='on'>
    <topology sockets='1' dies='1' cores='6' threads='2'/>
    <!-- topoext exposes AMD SMT topology to guest — required for correct core count -->
    <feature policy='require' name='topoext'/>
  </cpu>

  <clock offset='localtime'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
    <timer name='hypervclock' present='yes'/>
  </clock>

  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>

  <pm>
    <suspend-to-mem enabled='no'/>
    <suspend-to-disk enabled='no'/>
  </pm>

  <devices>
    <emulator>/run/libvirt/nix-emulators/qemu-system-x86_64</emulator>

    <!-- Main disk (VirtIO for best performance) -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' cache='none' io='native' discard='unmap'/>
      <source file='/var/lib/libvirt/images/windows.qcow2'/>
      <target dev='vda' bus='virtio'/>
      <boot order='1'/>
    </disk>

    <!-- Windows installer ISO -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/var/lib/libvirt/images/windows.iso'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
      <boot order='2'/>
    </disk>

    <!-- VirtIO drivers ISO — needed during Windows install to see the VirtIO disk -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/var/lib/libvirt/images/virtio-win.iso'/>
      <target dev='sdb' bus='sata'/>
      <readonly/>
    </disk>

    <controller type='usb' index='0' model='qemu-xhci' ports='15'/>
    <controller type='pci' index='0' model='pcie-root'/>
    <controller type='pci' index='1' model='pcie-root-port'>
      <model name='pcie-root-port'/>
      <target chassis='1' port='0x10'/>
    </controller>
    <controller type='pci' index='2' model='pcie-root-port'>
      <model name='pcie-root-port'/>
      <target chassis='2' port='0x11'/>
    </controller>
    <controller type='pci' index='3' model='pcie-root-port'>
      <model name='pcie-root-port'/>
      <target chassis='3' port='0x12'/>
    </controller>
    <controller type='pci' index='4' model='pcie-root-port'>
      <model name='pcie-root-port'/>
      <target chassis='4' port='0x13'/>
    </controller>
    <controller type='pci' index='5' model='pcie-root-port'>
      <model name='pcie-root-port'/>
      <target chassis='5' port='0x14'/>
    </controller>

    <!-- VirtIO NIC -->
    <interface type='network'>
      <source network='default'/>
      <model type='virtio'/>
    </interface>

    <!-- RTX 3070 VGA — PCI 08:00.0 -->
    <hostdev mode='subsystem' type='pci' managed='yes'>
      <source>
        <address domain='0x0000' bus='0x08' slot='0x00' function='0x0'/>
      </source>
      <address type='pci' domain='0x0000' bus='0x01' slot='0x00' function='0x0' multifunction='on'/>
    </hostdev>

    <!-- RTX 3070 HDMI Audio — PCI 08:00.1 -->
    <hostdev mode='subsystem' type='pci' managed='yes'>
      <source>
        <address domain='0x0000' bus='0x08' slot='0x00' function='0x1'/>
      </source>
      <address type='pci' domain='0x0000' bus='0x01' slot='0x00' function='0x1'/>
    </hostdev>

    <!-- Looking Glass IVSHMEM — 128 MiB shared memory buffer -->
    <shmem name='looking-glass'>
      <model type='ivshmem-plain'/>
      <size unit='M'>128</size>
      <address type='pci' domain='0x0000' bus='0x02' slot='0x01' function='0x0'/>
    </shmem>

    <!-- Virtual display for VNC (initial install only; disable after Looking Glass is working) -->
    <graphics type='vnc' port='-1' autoport='yes' listen='127.0.0.1'>
      <listen type='address' address='127.0.0.1'/>
    </graphics>
    <video>
      <model type='qxl' ram='65536' vram='65536' vgamem='16384' heads='1'/>
    </video>

    <!-- USB tablet gives accurate mouse position over VNC during install -->
    <input type='tablet' bus='usb'/>
    <input type='mouse' bus='ps2'/>
    <input type='keyboard' bus='ps2'/>

    <memballoon model='virtio'/>
  </devices>
</domain>
