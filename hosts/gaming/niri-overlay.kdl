// Host-specific niri overlay for gaming, included by the shared
// dotfiles/common/configs/niri-config.kdl via `include "niri-overlay.kdl"`.

// Named workspaces pinned to specific monitors (gaming host outputs:
// DP-1 = ASUS VG249, HDMI-A-1 = Dell S2419HGF). Used below by window-rules
// to send specific apps to specific monitor + workspace slots.
workspace "asus-1" {
    open-on-output "DP-1"
}
workspace "asus-2" {
    open-on-output "DP-1"
}
workspace "asus-3" {
    open-on-output "DP-1"
}
workspace "dell-1" {
    open-on-output "HDMI-A-1"
}
workspace "dell-2" {
    open-on-output "HDMI-A-1"
}
workspace "dell-3" {
    open-on-output "HDMI-A-1"
}
workspace "dell-4" {
    open-on-output "HDMI-A-1"
}
workspace "dell-5" {
    open-on-output "HDMI-A-1"
}

// Pin specific apps to specific monitor + workspace slots (see the
// named workspaces defined above).
window-rule {
    match app-id=r#"^kitty$"#
    open-on-workspace "asus-1"
}

window-rule {
    match app-id=r#"^steam$"#
    open-on-workspace "asus-2"
}

window-rule {
    match app-id=r#"^net\.lutris\.Lutris$"#
    open-on-workspace "asus-3"
}

window-rule {
    match app-id=r#"^vesktop$"#
    open-on-workspace "dell-1"
    open-maximized true
}

window-rule {
    match app-id=r#"^app\.zen_browser\.zen$"#
    open-on-workspace "dell-2"
    open-maximized true
}

window-rule {
    match app-id=r#"^dev\.aunetx\.deezer$"#
    open-on-workspace "dell-3"
    open-maximized true
}

window-rule {
    match app-id=r#"^org\.qbittorrent\.qBittorrent$"#
    open-on-workspace "dell-4"
    open-maximized true
}

window-rule {
    match app-id=r#"^thunar$"#
    open-on-workspace "dell-5"
}

// Initial-setup launcher for the pinned apps above. Gaming-only because Steam
// and Lutris are installed only here; binds in an included file merge into the
// shared config's `binds`. Deezer's flatpak start is delayed 3s since it
// silently lost the launch race on a cold-booted session.
binds {
    Mod+G hotkey-overlay-title="Launch Initial Setup: Steam, Vesktop, Lutris, Deezer, qBittorrent" { spawn-sh "steam & vesktop & lutris & (sleep 3; flatpak run dev.aunetx.deezer) & qbittorrent &"; }
}
