// Host-specific niri overlay for gaming, included by the shared
// dotfiles/common/configs/niri-config.kdl via `include "niri-overlay.kdl"`.

// Named workspaces pinned to specific monitors (gaming host outputs:
// DP-1 = ASUS VG249, HDMI-A-1 = Dell S2419HGF). Used below by window-rules
// to send specific apps to specific monitor + workspace slots.
workspace "asus-1" {
    open-on-output "DP-1"
}
workspace "asus-2" {
    open-on-output "DP-1"
}
workspace "asus-3" {
    open-on-output "DP-1"
}
workspace "dell-1" {
    open-on-output "HDMI-A-1"
}
workspace "dell-2" {
    open-on-output "HDMI-A-1"
}
workspace "dell-3" {
    open-on-output "HDMI-A-1"
}
workspace "dell-4" {
    open-on-output "HDMI-A-1"
}

// Pin specific apps to specific monitor + workspace slots (see the
// named workspaces defined above).
window-rule {
    match app-id=r#"^kitty$"#
    open-on-workspace "asus-1"
}

window-rule {
    match app-id=r#"^steam$"#
    open-on-workspace "asus-2"
}

window-rule {
    match app-id=r#"^net\.lutris\.Lutris$"#
    open-on-workspace "asus-3"
}

window-rule {
    match app-id=r#"^vesktop$"#
    open-on-workspace "dell-1"
    open-maximized true
}

window-rule {
    match app-id=r#"^app\.zen_browser\.zen$"#
    open-on-workspace "dell-2"
    open-maximized true
}

window-rule {
    match app-id=r#"^dev\.aunetx\.deezer$"#
    open-on-workspace "dell-3"
    open-maximized true
}

window-rule {
    match app-id=r#"^org\.qbittorrent\.qBittorrent$"#
    open-on-workspace "dell-4"
    open-maximized true
}
