# <Hostname — human-readable description>
# Note the difference from the server entry: the `system` override (and the
# optional `nixpkgs` pin). The disko wiring below is commented out by default —
# disk layout is host-specific, so write hosts/<hostname>/disko.nix by hand
# (see the disko project's examples) and make sure flake.nix has a `disko`
# input first. For an x86_64 remote host, use the server entry instead (drop
# the overrides).
<hostname> = mkSystem {
  name = "<hostname>";
  system = "aarch64-linux";
  # Uncomment to pin this host to the stable channel (needs a `nixpkgs-stable`
  # flake input):
  # nixpkgs = nixpkgs-stable;
  modules = commonModules ++ [
    # Uncomment both lines below for declarative disk partitioning
    # (nixos-anywhere-style installs) — also create hosts/<hostname>/disko.nix
    # first (Step 2).
    # disko.nixosModules.disko
    "${self}/hosts/<hostname>/hardware-configuration.nix"
    # "${self}/hosts/<hostname>/disko.nix"
    "${self}/hosts/<hostname>/configuration.nix"
  ];
};
