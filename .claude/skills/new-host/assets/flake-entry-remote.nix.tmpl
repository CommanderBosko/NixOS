# <Hostname — human-readable description>
# Note the difference from the server entry: the `system` and `nixpkgs`
# overrides. Mirrors how vpn-server is defined. For an x86_64 remote host,
# use the server entry instead (drop both overrides).
<hostname> = mkSystem {
  name = "<hostname>";
  system = "aarch64-linux";
  nixpkgs = nixpkgs-stable;
  modules = commonModules ++ [
    "${self}/hosts/<hostname>/hardware-configuration.nix"
    "${self}/hosts/<hostname>/configuration.nix"
  ];
};
