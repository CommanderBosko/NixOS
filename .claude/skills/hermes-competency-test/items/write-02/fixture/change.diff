diff --git a/modules/restic-backup.nix b/modules/restic-backup.nix
new file mode 100644
index 0000000..b84e0d9
--- /dev/null
+++ b/modules/restic-backup.nix
@@ -0,0 +1,35 @@
+# Nightly restic backup of atlas's service data to the backup box.
+{ config, ... }:
+{
+  services.restic.backups.nightly = {
+    initialize = true;
+    repository = "sftp:restic@192.0.2.50:/srv/restic/atlas";
+    passwordFile = config.sops.secrets.restic_password.path;
+
+    paths = [
+      "/var/lib/paperless"
+      "/var/lib/vaultwarden"
+      "/home/mira/Documents"
+    ];
+    exclude = [
+      "/var/lib/paperless/consume"
+      "**/.cache"
+    ];
+
+    extraOptions = [
+      "sftp.command='ssh restic@192.0.2.50 -i /etc/ssh/ssh_host_ed25519_key -s sftp'"
+    ];
+
+    timerConfig = {
+      OnCalendar = "02:30";
+      RandomizedDelaySec = "45m";
+      Persistent = true;
+    };
+
+    pruneOpts = [
+      "--keep-daily 7"
+      "--keep-weekly 4"
+      "--keep-monthly 6"
+    ];
+  };
+}
